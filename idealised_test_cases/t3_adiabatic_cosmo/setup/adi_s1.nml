! 2026-11-17 ADIABATIC TWIN (user request): RAMSES counterpart of dyablo reio_v2/adi_rk2 (and adi_rk2_ent). Same ICs, levels,
! m_refine 16, MUSCL-Hancock HLLC minmod, pressure_fix beta_fix=0 (negative-pressure fallback only) as eps0.01_s1_b0_ics, but
! rt=.false., cooling=.false. (no Compton either), no SF (n_star 1e10) and no feedback. DM + gas only, to z = 6.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
rt=.false.
nrestart=0
nremap=10
nsubcycle=1,1,2,2,2,2
ncontrol=1
verbose=.false.
/
&AMR_PARAMS
levelmin=8
levelmax=12
ngridmax=150000
npartmax=200000
nexpand=1
/
&INIT_PARAMS
filetype='grafic'
initfile(1)='ic'
omega_b=0.049
/
&OUTPUT_PARAMS
aout=0.020, 0.030, 0.040, 0.050, 0.060, 0.070, 0.080, 0.090, 0.100, 0.110, 0.120, 0.130, 0.140
aend=0.14285714
walltime_hrs=1.
minutes_dump=8.
/
&POISSON_PARAMS
epsilon=1d-4
/
&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
riemann='hllc'
slope_type=1
pressure_fix=.true.
beta_fix=0.0
/
&REFINE_PARAMS
m_refine=5*16.
interpol_var=1
interpol_type=0
/
&SF_PARAMS
sf_model=0
eps_star=0.01
n_star=1d10
del_star=200.
T2_star=0.
g_star=1.
m_star=0.12938
randomize_sf=.true.
/
&FEEDBACK_PARAMS
eta_sn=0.0
yield=0.1
f_w=0.
t_sne=10.
delayed_cooling=.false.
/
&COOLING_PARAMS
cooling=.false.
metal=.false.
haardt_madau=.false.
self_shielding=.false.
z_ave=0.
/
&RT_PARAMS
X=1d0
Y=0d0
isHe=.false.
rt_star=.true.
sed_dir='sed'
sedprops_update=-1
rt_esc_frac=1d0
rt_flux_scheme='glf'
rt_courant_factor=0.8
rt_c_fraction=0.01
rt_nsubcycle=100
rt_otsa=.false.
rt_is_init_xion=.false.
rt_pressBoost=0d0
/
&RT_GROUPS
group_csn(1,:)=2.93045d-18
group_cse(1,:)=2.49351d-18
group_egy=20.2766
/
