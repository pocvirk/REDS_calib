! 2026-11-16 EdS gas-only pancake (Tep et al. App. B): slope_type=1 levels 6..8 pressure_fix=.false. (beta 0.5)
&RUN_PARAMS
cosmo=.true.
pic=.false.
poisson=.true.
hydro=.true.
rt=.false.
nrestart=0
nremap=10
nsubcycle=1,1,2,2,2,2
ncontrol=10
verbose=.false.
/
&AMR_PARAMS
levelmin=6
levelmax=8
ngridmax=200000
nexpand=1
/
&INIT_PARAMS
filetype='grafic'
initfile(1)='ic'
omega_b=1.0
/
&OUTPUT_PARAMS
aout=0.33333333, 0.5, 0.66666667, 0.75, 0.83333333
aend=1.0
walltime_hrs=-1.
/
&POISSON_PARAMS
epsilon=1d-4
/
&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
riemann='hllc'
slope_type=1
pressure_fix=.false.
beta_fix=0.5
/
&REFINE_PARAMS
m_refine=10*1.
interpol_var=1
interpol_type=0
/
&COOLING_PARAMS
cooling=.false.
metal=.false.
/
