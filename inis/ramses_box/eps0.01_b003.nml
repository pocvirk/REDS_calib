! 2026-11-15 test: eps0.01 restarted from output_00002 (z=19), beta_fix=0.03 (3D convergence: div u ~3x the 1D value); aend=0.1
! RAMSES-RT counterpart of dyablo runs/reio_v2/eps0.01 (boxB 4 Mpc/h 256^3, levels 8-12 = dyablo 6-10 x bx 4).
! Matched: ICs, cosmology, quasi-Lagrangian refinement (m_refine 16 = mass_refine_factor 16), first-order HLLC hydro
! (dyablo slope_enabled = false), pure H neq chemistry (X=1, no He/metals/UVB, case A + diffuse photons = dyablo),
! one grey group = dyablo 5e4 K black body, c = 0.01 c, BPASS Q(age) Z=0.001 to 200 Myr (sed_bpass_bb5e4), SF
! sf_model 0 (eps 0.01, n_H > 0.1, del 200 Omega_b rho_c, T/mu < 2e4, Poisson, m_star 1e4 Msun), thermal SN at 10 Myr
! (eta 0.2, 1e51 erg / 10 Msun), no delayed cooling. See ../README.md for the differences that remain.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
rt=.true.
nrestart=2
nremap=10
nsubcycle=1,1,2,2,2,2
ncontrol=1
verbose=.false.
/
&AMR_PARAMS
levelmin=8
levelmax=12
ngridmax=150000
npartmax=200000
nexpand=1
/
&INIT_PARAMS
filetype='grafic'
initfile(1)='/ccs/home/pocvirk/powork/dyablo/ics/boxB_4mpc_256/level_008'
omega_b=0.049
/
&OUTPUT_PARAMS
aout=0.050, 0.055, 0.060, 0.065, 0.070, 0.075, 0.080, 0.085, 0.090, 0.095, 0.100
aend=0.1
walltime_hrs=1.
minutes_dump=8.
/
&POISSON_PARAMS
epsilon=1d-4
/
&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
riemann='hllc'
slope_type=0
pressure_fix=.true.
beta_fix=0.03
/
&REFINE_PARAMS
m_refine=5*16.
interpol_var=1
interpol_type=0
/
&SF_PARAMS
sf_model=0
eps_star=0.01
n_star=0.1
del_star=200.
T2_star=0.
g_star=1.
m_star=0.12938
randomize_sf=.true.
/
&FEEDBACK_PARAMS
eta_sn=0.2
yield=0.1
f_w=0.
t_sne=10.
delayed_cooling=.false.
/
&COOLING_PARAMS
cooling=.true.
metal=.false.
haardt_madau=.false.
self_shielding=.false.
z_ave=0.
/
&RT_PARAMS
X=1d0
Y=0d0
isHe=.false.
rt_star=.true.
sed_dir='sed'
sedprops_update=-1
rt_esc_frac=1d0
rt_flux_scheme='glf'
rt_courant_factor=0.8
rt_c_fraction=0.01
rt_nsubcycle=100
rt_otsa=.false.
rt_pressBoost=0d0
/
&RT_GROUPS
group_csn(1,:)=2.93045d-18
group_cse(1,:)=2.49351d-18
group_egy=20.2766
/
