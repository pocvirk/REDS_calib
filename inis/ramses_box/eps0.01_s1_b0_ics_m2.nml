! 2026-11-16 night: matched RAMSES reference for dyablo: eps0.01 from the ICs (z=100) with slope_type=1 + pressure_fix beta_fix=0 (negative-pressure fallback only)
! RESOLUTION TEST: as eps0.01_s1_b0_ics but m_refine=2 (= dyablo mass_refine_factor 2, eps0.01_rk2_ei_m2), to a=0.065
! RAMSES-RT counterpart of dyablo runs/reio_v2/eps0.01 (boxB 4 Mpc/h 256^3, levels 8-12 = dyablo 6-10 x bx 4).
! Matched: ICs, cosmology, quasi-Lagrangian refinement (m_refine 16 = mass_refine_factor 16), first-order HLLC hydro
! (dyablo slope_enabled = false), pure H neq chemistry (X=1, no He/metals/UVB, case A + diffuse photons = dyablo),
! one grey group = dyablo 5e4 K black body, c = 0.01 c, BPASS Q(age) Z=0.001 to 200 Myr (sed_bpass_bb5e4), SF
! sf_model 0 (eps 0.01, n_H > 0.1, del 200 Omega_b rho_c, T/mu < 2e4, Poisson, m_star 1e4 Msun), thermal SN at 10 Myr
! (eta 0.2, 1e51 erg / 10 Msun), no delayed cooling. See ../README.md for the differences that remain.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
rt=.true.
nrestart=0
nremap=10
nsubcycle=1,1,2,2,2,2
ncontrol=1
verbose=.false.
/
&AMR_PARAMS
levelmin=8
levelmax=12
ngridmax=150000
npartmax=200000
nexpand=1
/
&INIT_PARAMS
filetype='grafic'
initfile(1)='ic'
omega_b=0.049
/
&OUTPUT_PARAMS
aout=0.020, 0.030, 0.040, 0.050, 0.055, 0.060, 0.065
aend=0.0651
walltime_hrs=1.
minutes_dump=8.
/
&POISSON_PARAMS
epsilon=1d-4
/
&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
riemann='hllc'
slope_type=1
pressure_fix=.true.
beta_fix=0.0
/
&REFINE_PARAMS
m_refine=5*2.
interpol_var=1
interpol_type=0
/
&SF_PARAMS
sf_model=0
eps_star=0.01
n_star=0.1
del_star=200.
T2_star=0.
g_star=1.
m_star=0.12938
randomize_sf=.true.
/
&FEEDBACK_PARAMS
eta_sn=0.2
yield=0.1
f_w=0.
t_sne=10.
delayed_cooling=.false.
/
&COOLING_PARAMS
cooling=.true.
metal=.false.
haardt_madau=.false.
self_shielding=.false.
z_ave=0.
/
&RT_PARAMS
X=1d0
Y=0d0
isHe=.false.
rt_star=.true.
sed_dir='sed'
sedprops_update=-1
rt_esc_frac=1d0
rt_flux_scheme='glf'
rt_courant_factor=0.8
rt_c_fraction=0.01
rt_nsubcycle=100
rt_otsa=.false.
rt_is_init_xion=.false.
rt_pressBoost=0d0
/
&RT_GROUPS
group_csn(1,:)=2.93045d-18
group_cse(1,:)=2.49351d-18
group_egy=20.2766
/
